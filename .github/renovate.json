{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "prHourlyLimit": 8,
    "pre-commit": {
        "enabled": true
    },
    "lockFileMaintenance": {
        "enabled": true,
        "schedule": [
            "at any time"
        ]
    },
    "semanticCommitType": "fix",
    "rangeStrategy": "auto"
}
